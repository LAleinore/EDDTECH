# EduMind AI - Environment Configuration
# Copy this file to .env and fill in values for production

# Backend Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=edumind-super-secure-production-secret-key-32-chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edumind_db
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/edumind_db
# SQLite fallback for quick local testing without docker
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./edumind.db

# Supabase Auth & Storage (Optional if using direct local auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# AI Gateway Configuration
AI_PROVIDER=gemini # options: gemini, openai, anthropic, demo
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
DEMO_MODE_DEFAULT=true

# Mobile Client Configuration
API_BASE_URL=http://localhost:8000/api
